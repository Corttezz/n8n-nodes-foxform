{
  "name": "n8n-nodes-foxform",
  "version": "0.1.0",
  "description": "FoxForm nodes for n8n: trigger on new responses, read forms and responses, submit responses.",
  "license": "MIT",
  "homepage": "https://foxform.app",
  "keywords": [
    "n8n-community-node-package",
    "foxform",
    "forms",
    "surveys",
    "quiz"
  ],
  "author": {
    "name": "Mamute Cloud",
    "email": "tools@mamutetech.com"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/auth/FoxFormApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FoxForm/FoxForm.node.js",
      "dist/nodes/FoxFormTrigger/FoxFormTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Corttezz/n8n-nodes-foxform.git"
  },
  "bugs": {
    "url": "https://github.com/Corttezz/n8n-nodes-foxform/issues"
  }
}
